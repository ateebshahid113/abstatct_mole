<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_room_form" model="ir.ui.view">
        <field name="name">school.room.form</field>
        <field name="model">school.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="building"/>
                        <field name="floor"/>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="grade"/>
                                    <field name="age"/>
                                </list>
                            </field>
                        </page>
                        <page string="Teachers">
                            <field name="teacher_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="subject"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_room_list" model="ir.ui.view">
        <field name="name">school.room.list</field>
        <field name="model">school.room</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="capacity"/>
                <field name="building"/>
                <field name="floor"/>
            </list>
        </field>
    </record>

    <record id="action_school_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">school.room</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
