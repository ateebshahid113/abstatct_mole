<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_teacher_wizard_form" model="ir.ui.view">
        <field name="name">Student Teacher Wizard</field>
        <field name="model">student.teacher.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Student to Teacher">
                <group>
                    <field name="student_id"/>
                    <field name="teacher_id"/>
                    <field name="room_id"/>
                </group>
                <footer>
                    <button name="assign_student_teacher" string="Assign" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_student_teacher_wizard" model="ir.actions.act_window">
        <field name="name">Student Teacher Assignment</field>
        <field name="res_model">student.teacher.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
